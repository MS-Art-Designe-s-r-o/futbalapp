generator client {
  provider = "prisma-client-js"
  // native = vývojový stroj; debian-openssl-3.0.x = node:22-slim Docker image
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Používatelia a roly
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  COACH
  PLAYER
  PARENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?
  passwordHash String?
  firstName    String
  lastName     String
  locale       String     @default("sk")
  /// Testovacie (demo) konto pre app-store review — vidí len demo dáta a je pre
  /// ostatných neviditeľné. Ostatní používatelia demo dáta nevidia.
  isDemo       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles        UserRole[]
  guardianOf   Guardian[]
  member       Member?
  messages     Message[]
  channelMemberships ChannelMember[]
  channelReads ChannelRead[]
  pushTokens   PushToken[]
  nominationRequestsMade    NominationRequest[] @relation("NominationRequestRequestedBy")
  nominationRequestsDecided NominationRequest[] @relation("NominationRequestDecidedBy")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  /// Expo push token (ExponentPushToken[...])
  token     String   @unique
  platform  String // ios | android
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRole {
  id     String  @id @default(cuid())
  userId String
  role   Role
  /// Scope pre COACH: družstvo, ktoré trénuje. ADMIN/MANAGER = null (celý klub).
  teamId String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id])

  @@unique([userId, role, teamId])
}

// ---------------------------------------------------------------------------
// Členovia (hráči) a rodičia
// ---------------------------------------------------------------------------

enum MemberStatus {
  ACTIVE
  INACTIVE
  GUEST
}

enum GuardianRelation {
  MOTHER
  FATHER
  GUARDIAN
  RELATIVE
}

model Member {
  id             String       @id @default(cuid())
  /// Poradové číslo pre variabilný symbol (RRMM + 6 číslic)
  memberSeq      Int          @unique @default(autoincrement())
  /// Testovací (demo) člen — viditeľný len pre demo konto (app-store review).
  isDemo         Boolean      @default(false)
  firstName      String
  lastName       String
  /// Voliteľné — hráči majú dátum narodenia (zaradenie do kategórie),
  /// nehráčski členovia (rodič, tréner) nemusia.
  birthDate      DateTime?
  /// Rodné číslo (RRMMDD/XXXX) — z neho sa odvodzuje dátum narodenia a pohlavie
  birthNumber    String?
  /// Pohlavie odvodené z rodného čísla: M | F
  sex            String?
  /// Krajina pôvodu
  originCountry  String?
  // --- Bydlisko ---
  addressStreet      String?
  addressHouseNumber String?
  addressZip         String?
  addressCity        String?
  status         MemberStatus @default(ACTIVE)
  futbalnetId    String?      @unique
  healthNotes    String?
  photoUrl       String?
  /// sociálny prípad — hráčovi sa nevytvára členský poplatok (nastaví vedúci)
  socialCase     Boolean      @default(false)
  /// úroveň trénerskej licencie: A_PRO | A | B | C | GK (brankár)
  licenseLevel   String?

  // --- Registračný preukaz / futbalnet (import z Excelu) ---
  /// Registračné číslo hráča vo futbalnete — kľúč pre idempotentný import
  registrationNumber     String?   @unique
  /// Materský klub
  homeClub               String?
  /// Hosťujúci klub (ak hráč hosťuje inde)
  guestClub              String?
  /// Klubová príslušnosť (za ktorý klub aktuálne hrá)
  clubAffiliation        String?
  /// Platnosť registračného preukazu do — sledované na dashboarde
  registrationValidUntil DateTime?
  /// Dátum registrácie do klubu
  registeredAt           DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// Vyplnené, ak má hráč vlastný login (starší hráči)
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])

  guardians          Guardian[]
  memberships        TeamMembership[]
  feeAssignments     FeeAssignment[]
  paymentObligations PaymentObligation[]
  attendances        Attendance[]
  nominations        MatchNomination[]
  tournamentNominations TournamentNomination[]
  nominationRequests NominationRequest[]
  matchEvents        MatchEvent[]        @relation("MatchEventMember")
  relatedMatchEvents MatchEvent[]        @relation("MatchEventRelatedMember")
  bankPayerLinks     BankPayerLink[]
  suggestedTxns      BankTransaction[]   @relation("TxSuggestedMember")
  matchedTxns        BankTransaction[]   @relation("TxMatchedMember")
  photo              MemberPhoto?
  fitnessTests       FitnessTest[]
  syncIgnores        MemberSyncIgnore[]

  /// Súhlas so zverejnením mena a priezviska na verejnom webe (zbiera klub od
  /// hráča / zákonného zástupcu). Bez súhlasu sa hráč na verejnom webe nezobrazí.
  publicProfileConsent Boolean   @default(false)
  /// Súhlas so zverejnením fotografie na verejnom webe. Platí len spolu s
  /// `publicProfileConsent`.
  publicPhotoConsent   Boolean   @default(false)
  /// Kedy bol súhlas naposledy zaznamenaný / zmenený.
  publicConsentAt      DateTime?
}

/// Rozdiely z ISSF synchronizácie, ktoré používateľ zvolil „ponechať" — pri
/// ďalšej synchronizácii sa daná hodnota poľa ignoruje (kým sa v ISSF nezmení).
model MemberSyncIgnore {
  id        String   @id @default(cuid())
  memberId  String
  field     String
  value     String
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, field])
}

/// Fotka hráča uložená ako data URL (mimo zoznamu členov, aby ho nezaťažovala).
model MemberPhoto {
  id        String   @id @default(cuid())
  memberId  String   @unique
  dataUrl   String   // "data:image/jpeg;base64,..."
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Guardian {
  id       String           @id @default(cuid())
  userId   String
  memberId String
  relation GuardianRelation

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([userId, memberId])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model RegistrationRequest {
  id             String  @id @default(cuid())
  /// CHILD = dieťa s rodičom, ADULT = dospelý/starší hráč sám za seba,
  /// PARENT = rodič len s kontom (deti sú už členmi klubu)
  applicantType  String  @default("CHILD")
  /// meno hráča — prázdne pri type PARENT (len konto rodiča)
  childFirstName String?
  childLastName  String?
  childBirthDate DateTime?
  /// Rodné číslo hráča (povinné v novom formulári)
  birthNumber    String?
  sex            String?
  /// Registračné číslo hráča (nemusí byť pridelené)
  playerRegistrationNumber String?
  originCountry  String?
  addressStreet      String?
  addressHouseNumber String?
  addressZip         String?
  addressCity        String?
  /// fotka hráča (data URL) — prenesie sa na člena pri schválení
  photoDataUrl   String?
  healthNotes    String?
  /// voliteľné vlastné prihlásenie hráča (starší hráč / dospelý)
  playerEmail    String?
  // rodič — nepovinný (chýba pri dospelom hráčovi)
  parentFirstName String?
  parentLastName  String?
  parentEmail     String?
  parentPhone     String?
  parentRelation  GuardianRelation?
  /// mená existujúcich detí (type PARENT) — vedenie/tréner ich priradí ku kontu
  parentChildrenNote String?
  consentGdpr   Boolean
  consentPhotos Boolean
  note          String?
  status        RegistrationStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  createdMemberId String?
  createdAt     DateTime           @default(now())
}

/// Žiadosť o presun hráča medzi družstvami. Ak ju podá tréner, ktorý nespravuje
/// aktuálne družstvo hráča, musí ju schváliť tréner aktuálneho družstva alebo vedenie.
/// mode: MOVE = vyradiť z aktuálneho a pridať do nového; ADD = len pridať do nového.
model TeamTransferRequest {
  id            String    @id @default(cuid())
  memberId      String
  fromTeamId    String?
  toTeamId      String
  mode          String    @default("MOVE")
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById String
  resolvedById  String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([status])
  @@index([memberId])
}

/// Úloha pre vedenie/trénerov. Priradená buď konkrétnemu členovi (assigneeUserId),
/// alebo celej funkcii (assigneeRole = ADMIN | MANAGER | COACH).
model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  done           Boolean   @default(false)
  /// Testovacia (demo) úloha — viditeľná len pre demo konto (app-store review).
  isDemo         Boolean   @default(false)
  doneAt         DateTime?
  doneById       String?
  createdById    String
  assigneeUserId String?
  assigneeRole   String?
  createdAt      DateTime  @default(now())

  comments TaskComment[]

  @@index([done])
}

/// Jednorazový token na obnovenie zabudnutého hesla (platnosť ~1 hodina).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Komentár k úlohe (tréner/vedúci/admin).
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Sezóny a kategórie
// ---------------------------------------------------------------------------

model Season {
  id        String   @id @default(cuid())
  name      String   @unique // "2026/2027"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  categoryRules CategoryRule[]
  memberships   TeamMembership[]
  feePlans      FeePlan[]
  events        Event[]
}

model TeamCategory {
  id        String @id @default(cuid())
  code      String @unique // "U8" ... "MUZI"
  name      String
  sortOrder Int
  /// URL stránky súťaže na futbalnet.sk pre túto kategóriu (zdroj sync-u zápasov)
  futbalnetCompetitionUrl String?
  /// Názov tímu na futbalnete (na rozpoznanie domáci/hostia), napr. "FK Košická Nová Ves"
  futbalnetTeamName       String?
  /// Verejná URL súťaže na sportnet.sme.sk (základ pre embed programu a tabuľky),
  /// napr. https://sportnet.sme.sk/futbalnet/z/mfz-kosice/s/pripravka-u11
  sportnetUrl             String?

  rules    CategoryRule[]
  feePlans FeePlan[]
  teams    Team[]
}

/// Družstvo pod vekovou kategóriou (napr. "U10 A", "U10 B").
/// Pri jednom družstve na kategóriu sa volá jednoducho podľa kódu ("U10").
model Team {
  id             String @id @default(cuid())
  teamCategoryId String
  name           String
  sortOrder      Int    @default(0)
  /// Testovacie (demo) družstvo — viditeľné len pre demo konto (app-store review).
  isDemo         Boolean @default(false)
  /// URL programu súťaže tohto družstva na sportnet.sme.sk (zdroj rozpisu zápasov)
  sportnetProgramUrl String?
  /// Presný názov tohto družstva na sportnete (napr. "FK Košická Nová Ves B")
  sportnetTeamName   String?
  /// Základná URL súťaže na sportnet.sme.sk pre zobrazenie tabuľky/programu
  /// v sekcii Tabuľka (per družstvo, aby A a B mohli mať vlastnú súťaž).
  sportnetUrl        String?

  teamCategory TeamCategory     @relation(fields: [teamCategoryId], references: [id])
  memberships  TeamMembership[]
  userRoles    UserRole[]
  events       Event[]
  audienceEvents Event[]        @relation("EventAudience")
  channels     Channel[]
  fitnessTests FitnessTest[]

  @@unique([teamCategoryId, name])
}

model CategoryRule {
  id             String @id @default(cuid())
  seasonId       String
  teamCategoryId String
  birthYearFrom  Int
  birthYearTo    Int? // null = bez hornej hranice (najmladší)

  season       Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamCategory TeamCategory @relation(fields: [teamCategoryId], references: [id])

  @@unique([seasonId, teamCategoryId])
}

model TeamMembership {
  id          String    @id @default(cuid())
  memberId    String
  seasonId    String
  teamId      String
  isException Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  // hráč môže byť vo viacerých skupinách naraz (jedna sezóna, viac družstiev)
  @@unique([memberId, seasonId, teamId])
  @@index([memberId, seasonId])
}

// ---------------------------------------------------------------------------
// Financie
// ---------------------------------------------------------------------------

enum FeePeriod {
  MONTHLY
  QUARTERLY
  ONE_TIME
  SEASON
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
}

enum BankMatchStatus {
  UNMATCHED
  MATCHED
  IGNORED
  MANUAL
}

model FeePlan {
  id             String    @id @default(cuid())
  seasonId       String
  teamCategoryId String?
  name           String
  amountCents    Int
  currency       String    @default("EUR")
  period         FeePeriod
  dueDay         Int       @default(15)
  /// Splatnosť jednorazového predpisu (period = ONE_TIME)
  dueDate        DateTime?
  activeFrom     DateTime
  activeTo       DateTime?

  season       Season          @relation(fields: [seasonId], references: [id])
  teamCategory TeamCategory?   @relation(fields: [teamCategoryId], references: [id])
  assignments  FeeAssignment[]
}

model FeeAssignment {
  id             String  @id @default(cuid())
  feePlanId      String
  memberId       String
  overrideCents  Int?
  discountReason String?
  active         Boolean @default(true)

  feePlan     FeePlan             @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  obligations PaymentObligation[]

  @@unique([feePlanId, memberId])
}

model PaymentObligation {
  id              String        @id @default(cuid())
  feeAssignmentId String
  memberId        String
  periodLabel     String // "2026-09"
  amountCents     Int
  paidCents       Int           @default(0)
  variableSymbol  String
  dueDate         DateTime
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  feeAssignment FeeAssignment  @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  member        Member         @relation(fields: [memberId], references: [id])
  matches       PaymentMatch[]
  dunning       DunningNotice[]

  @@unique([feeAssignmentId, periodLabel])
  @@index([variableSymbol])
  @@index([status, dueDate])
}

model BankTransaction {
  id               String          @id @default(cuid())
  source           String // CAMT | CSV | XLS | API
  externalId       String          @unique
  date             DateTime
  amountCents      Int
  currency         String          @default("EUR")
  variableSymbol   String?
  counterpartyIban String?
  counterpartyName String?
  message          String?
  matchStatus      BankMatchStatus @default(UNMATCHED)
  /// Návrh spárovania podľa mena/zdrobneniny (čaká na potvrdenie)
  suggestedMemberId String?
  /// Potvrdený člen, ku ktorému pohyb patrí (aj bez otvorenej povinnosti)
  matchedMemberId   String?
  importedAt       DateTime        @default(now())

  matches         PaymentMatch[]
  expense         Expense?
  suggestedMember Member?        @relation("TxSuggestedMember", fields: [suggestedMemberId], references: [id])
  matchedMember   Member?        @relation("TxMatchedMember", fields: [matchedMemberId], references: [id])

  @@index([variableSymbol])
  @@index([matchStatus])
}

enum ExpenseStatus {
  PLANNED
  PAID
}

/// Výdavok klubu (plánovaný alebo uhradený; uhradené sa párujú s odchádzajúcimi pohybmi výpisu)
model Expense {
  id                String        @id @default(cuid())
  payee             String
  description       String?
  amountCents       Int
  variableSymbol    String?
  iban              String?
  dueDate           DateTime?
  status            ExpenseStatus @default(PLANNED)
  paidAt            DateTime?
  bankTransactionId String?       @unique
  createdAt         DateTime      @default(now())

  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)

  @@index([status])
}

/// Naučená väzba platobného účtu (IBAN) na člena — po prvom ručnom spárovaní
/// sa ďalšie platby z toho istého účtu párujú automaticky.
model BankPayerLink {
  id        String   @id @default(cuid())
  iban      String   @unique
  memberId  String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model PaymentMatch {
  id                  String   @id @default(cuid())
  bankTransactionId   String
  paymentObligationId String
  amountCents         Int
  matchedBy           String // AUTO | MANUAL
  matchedAt           DateTime @default(now())

  bankTransaction   BankTransaction   @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  paymentObligation PaymentObligation @relation(fields: [paymentObligationId], references: [id], onDelete: Cascade)

  @@unique([bankTransactionId, paymentObligationId])
}

model DunningNotice {
  id                  String   @id @default(cuid())
  paymentObligationId String
  level               Int
  channel             String // PUSH | EMAIL
  sentAt              DateTime @default(now())

  paymentObligation PaymentObligation @relation(fields: [paymentObligationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Udalosti, dochádzka, zápasy
// ---------------------------------------------------------------------------

enum EventType {
  TRAINING
  MATCH
  TOURNAMENT
  CLUB_EVENT
  PARENT_MEETING
}

enum EventSource {
  INTERNAL
  FUTBALNET
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  INJURED
  SICK
  UNKNOWN
}

enum Rsvp {
  GOING
  NOT_GOING
  NO_REPLY
}

model Event {
  id       String    @id @default(cuid())
  type     EventType
  seasonId String
  /// Testovacia (demo) udalosť — viditeľná len pre demo konto (app-store review).
  isDemo   Boolean   @default(false)
  /// null = celoklubová udalosť (bez konkrétneho družstva)
  teamId   String?
  title    String
  startAt  DateTime
  endAt    DateTime?
  location String?
  /// Adresa miesta konania (pre odkaz / mapu Google Maps). Voliteľná, nezávislá od `location`.
  address  String?
  /// Povrch ihriska: PT | UT | VT | MT | MI (prír./umelá tráva, veľká/malá telocvičňa, multifunkčné)
  surface  String?
  /// Hracia plocha zo zoznamu v nastaveniach (null = iné miesto zadané textom)
  pitchId  String?
  source   EventSource @default(INTERNAL)
  /// Zverejniť na verejnom webe. Zápasy a turnaje (MATCH, TOURNAMENT) sa
  /// zverejňujú vždy; tréningy len ak je príznak zapnutý. Ostatné typy nikdy.
  isPublic Boolean     @default(false)
  futbalnetId String?  @unique
  /// Spoločné ID pre všetky výskyty opakovaného tréningu (napr. utorky+piatky)
  recurrenceGroupId String?
  /// Zápas turnaja: odkaz na udalosť turnaja (TOURNAMENT). Zmazanie turnaja zmaže aj jeho zápasy.
  parentEventId   String?
  /// Poradie zápasu v rámci turnaja (1. zápas, 2. zápas …)
  tournamentOrder Int?
  createdById String?
  createdAt   DateTime @default(now())

  season      Season       @relation(fields: [seasonId], references: [id])
  team        Team?        @relation(fields: [teamId], references: [id])
  pitch       Pitch?       @relation(fields: [pitchId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  match       Match?
  /// Družstvá, ktorých sa udalosť týka (napr. rodičovské združenie pre viac
  /// družstiev naraz). Prázdne = celoklubová udalosť. Používa sa nad rámec
  /// jediného `teamId` pri udalostiach smerovaných na viacero družstiev.
  audienceTeams Team[]     @relation("EventAudience")
  parent        Event?     @relation("TournamentMatches", fields: [parentEventId], references: [id], onDelete: Cascade)
  /// Zápasy turnaja (len pri type TOURNAMENT)
  children      Event[]    @relation("TournamentMatches")
  tournamentNominations TournamentNomination[]
  /// Účastníci (súperi) turnaja (len pri type TOURNAMENT)
  tournamentParticipants TournamentParticipant[]

  @@index([teamId, startAt])
  @@index([recurrenceGroupId])
  @@index([pitchId, startAt])
  @@index([parentEventId])
}

/// Mužstvo (klub z registra Club) zúčastnené na turnaji; súper pre zápasy turnaja.
model TournamentParticipant {
  id        String  @id @default(cuid())
  eventId   String
  clubName  String
  /// kópia Club.logoUrl v čase pridania
  logoUrl   String?
  sortOrder Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, clubName])
}

/// Hracia plocha klubu (názov + povrch); ponúka sa pri tvorbe tréningu/zápasu a
/// slúži na evidenciu obsadenosti.
model Pitch {
  id        String   @id @default(cuid())
  name      String   @unique
  /// PT | UT | VT | MT | MI
  surface   String
  /// Adresa plochy (pre odkaz / mapu Google Maps); použije sa pri udalosti bez vlastnej adresy.
  address   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  events Event[]
}

model Attendance {
  id        String           @id @default(cuid())
  eventId   String
  memberId  String
  status    AttendanceStatus @default(UNKNOWN)
  rsvp      Rsvp             @default(NO_REPLY)
  markedById String?
  markedAt  DateTime?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

enum MatchState {
  PLANNED
  LIVE
  FINISHED
  CANCELLED
}

/// Farba dresu, v ktorom družstvo nastúpi (tmavý = tmavomodrý, svetlý = biely).
enum JerseyColor {
  DARK
  LIGHT
}

enum NominationStatus {
  NOMINATED
  CONFIRMED
  DECLINED
  REMOVED
}

enum MatchEventType {
  GOAL
  ASSIST
  SUB_IN
  SUB_OUT
  YELLOW
  RED
  NOTE
  GOAL_CONCEDED
  FOUL
  SHOT
  CORNER
  PENALTY_SCORED
  PENALTY_MISSED
}

/// Register klubov (súperov) — meno a logo (napr. z futbalnetu). Pre našepkávač
/// a zobrazenie loga súpera pri zápase. Napĺňa sa ručne alebo importom.
model Club {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  /// futbalnet doména klubu (napr. fk-galaktik.futbalnet.sk) — kľúč k logu
  sportnetDomain String?
  createdAt DateTime @default(now())
}

model Match {
  id          String     @id @default(cuid())
  eventId     String     @unique
  /// logo súpera (denormalizované z registra klubov pri založení zápasu)
  opponentLogo String?
  opponent    String
  isHome      Boolean    @default(true)
  /// Priateľský zápas (nie je súčasťou súťaže SFZ) — synchronizácia s futbalnetom ho nemení.
  isFriendly  Boolean    @default(false)
  competition String?
  scoreUs     Int?
  scoreThem   Int?
  /// Čas zrazu/stretnutia hráčov pred zápasom (wall-clock UTC). Ak null, berie sa
  /// hodina pred začiatkom zápasu. Nastavuje tréner družstva alebo admin.
  meetAt      DateTime?
  /// Voľné poznámky k zápasu (edituje tréner družstva alebo admin).
  notes       String?
  /// Farba dresu, v ktorom nastúpime (tmavý/svetlý) — voliteľné, zobrazuje sa v kalendári.
  jerseyColor JerseyColor?
  /// Dresy nášho mužstva: jeden, alebo oba (hráči prinesú oba); prázdne = nezadané. jerseyColor je odvodené (spätná kompatibilita).
  jerseyColors JerseyColor[] @default([])
  /// Odkaz na video zo zápasu (napr. Veo) — dopĺňa sa pri/po zápase.
  videoUrl    String?
  /// Odkaz na highlighty zo zápasu (strih najlepších momentov).
  highlightsUrl String?
  state       MatchState @default(PLANNED)
  /// Odkaz na stránku zápasu na sportnete (zadaný ručne, ak zápas nevznikol importom programu)
  sportnetUrl String?
  /// Časomiera: dĺžka polčasu v minútach (nastavuje tréner družstva/admin).
  halfLengthMin       Int              @default(45)
  /// Časomiera: fáza a časové značky (klient z nich dopočítava minútu).
  timerPhase          MatchTimerPhase  @default(NOT_STARTED)
  firstHalfStartedAt  DateTime?
  firstHalfEndedAt    DateTime?
  secondHalfStartedAt DateTime?
  secondHalfEndedAt   DateTime?

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nominations MatchNomination[]
  nominationRequests NominationRequest[]
  events      MatchEvent[]
  syncLogs    MatchSyncLog[]
  photos      MatchPhoto[]
  videos      MatchVideo[]
}

/// Záznam o kontrole zápasu proti futbalnetu (večerný cron / ručné spustenie):
/// čo sa našlo a čo sa upravilo.
model MatchSyncLog {
  id        String   @id @default(cuid())
  matchId   String
  createdAt DateTime @default(now())
  /// CRON | MANUAL
  source    String
  /// UPDATED | NO_CHANGE | NO_RESULT | ERROR
  status    String
  /// Zoznam vykonaných úprav (čitateľné vety)
  changes   String[]

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

/// Fotky zo zápasu (uložené ako binárne dáta, servírované cez neuhádnuteľné ID).
model MatchPhoto {
  id           String   @id @default(cuid())
  matchId      String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

/// Videá zo zápasu nahrané z telefónu. Súbor je na disku (UPLOADS_DIR/videos/<storagePath>),
/// v DB len metadáta; servíruje sa cez neuhádnuteľné ID so stream/Range podporou.
model MatchVideo {
  id           String   @id @default(cuid())
  matchId      String
  mimeType     String
  /// veľkosť v bajtoch (MAX_VIDEO_MB je obmedzené na 2000 → zmestí sa do Int)
  size         Int
  /// pôvodný názov súboru z telefónu
  filename     String?
  /// názov súboru na disku (náhodný hex, relatívne k UPLOADS_DIR/videos)
  storagePath  String   @unique
  title        String?
  uploadedById String?
  createdAt    DateTime @default(now())

  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model MatchNomination {
  id          String           @id @default(cuid())
  matchId     String
  memberId    String
  status      NominationStatus @default(NOMINATED)
  shirtNumber Int?
  isStarting  Boolean          @default(false)
  createdAt   DateTime         @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([matchId, memberId])
}

/// Nominácia hráča na celý turnaj; prenáša sa do MatchNomination zápasov turnaja.
model TournamentNomination {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([eventId])
}

model MatchEvent {
  id              String         @id @default(cuid())
  /// Idempotentné ID z klienta — offline sync nesmie duplikovať udalosti
  clientId        String         @unique
  matchId         String
  minute          Int
  /// Nadstavený čas (napr. 45+2 → minute=45, stoppage=2)
  stoppage        Int?
  type            MatchEventType
  memberId        String?
  relatedMemberId String?
  note            String?
  createdById     String?
  createdAt       DateTime       @default(now())

  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  member        Member? @relation("MatchEventMember", fields: [memberId], references: [id])
  relatedMember Member? @relation("MatchEventRelatedMember", fields: [relatedMemberId], references: [id])

  @@index([matchId, minute])
}

// ---------------------------------------------------------------------------
// Komunikácia
// ---------------------------------------------------------------------------

enum ChannelKind {
  TEAM_ANNOUNCEMENTS // Oznamy družstva — píše len tréner/vedenie
  TEAM_TRAINING      // Tréningy — organizácia tréningov
  TEAM_GENERAL       // Všeobecné — diskusia rodičov/hráčov
  TEAM_EMAIL         // Hromadný email — správa sa zobrazí v kanáli a odíde e-mailom hráčom/rodičom (píše tréner družstva/admin)
  CLUB_ANNOUNCEMENT  // Celoklubové oznamy — píše len vedenie
  COACHES            // Interné pre trénerov
  BOARD              // Interné pre vedenie
}

model Channel {
  id        String      @id @default(cuid())
  kind      ChannelKind
  teamId    String?
  name      String
  /// Testovací (demo) kanál — viditeľný len pre demo konto (app-store review).
  isDemo    Boolean     @default(false)
  createdAt DateTime    @default(now())

  team     Team?           @relation(fields: [teamId], references: [id])
  members  ChannelMember[]
  messages Message[]
  reads    ChannelRead[]

  @@index([teamId])
}

/// Kedy naposledy používateľ čítal kanál — na zvýraznenie neprečítaných správ.
/// Vedie sa pre každého používateľa s prístupom (aj vedenie/tréner, ktorí nie
/// sú členmi kanála), preto samostatná tabuľka mimo ChannelMember.
model ChannelRead {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model ChannelMember {
  id        String  @id @default(cuid())
  channelId String
  userId    String
  isModerator Boolean @default(false)
  muted     Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime?
  replyToId String?

  channel    Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender     User            @relation(fields: [senderId], references: [id])
  attachment ChatAttachment?
  replyTo    Message?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[]       @relation("MessageReplies")

  @@index([replyToId])

  @@index([channelId, createdAt])
}

/// Príloha správy (obrázok alebo dokument), uložená priamo v DB.
model ChatAttachment {
  id        String   @id @default(cuid())
  messageId String   @unique
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Previerka výkonnosti hráča (behy, člnkový beh, skok z miesta) — hráč ich absolvuje niekoľkokrát ročne.
model FitnessTest {
  id            String   @id @default(cuid())
  memberId      String
  /// Družstvo hráča v čase previerky
  teamId        String?
  testedAt      DateTime @db.Date
  /// Časy v sekundách
  run10m        Float?
  /// (zrušená disciplína, stĺpec ostáva kvôli starým dátam)
  run20m        Float?
  run30m        Float?
  shuttleRun    Float?
  /// Vedenie lopty – lomený slalom v sekundách
  dribbleSlalom Float?
  /// Vytrvalostný beh v metroch (6 min mladší žiaci, 12 min starší žiaci)
  enduranceRun  Int?
  /// Dĺžka vytrvalostného behu v minútach (podľa kategórie družstva v čase previerky)
  enduranceMinutes Int?
  /// Skok do diaľky z miesta v cm
  standingJump  Int?
  /// Výdrž v zhybe nadhmatom v sekundách
  pullUpHang        Float?
  /// Vytrvalostný člnkový beh — počet úsekov
  shuttleEndurance  Int?
  /// Ľah-sed za 30 s — počet
  sitUps30          Int?
  /// Hod 2 kg plnou loptou vpred v metroch
  medicineBallThrow Float?
  /// Juggling – počet dotykov
  juggling          Int?
  /// Prihrávky v behu — počet úspešných
  passesRunning     Int?
  /// Strelba (presnosť) — počet zásahov
  shooting          Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([memberId, testedAt])
  @@index([testedAt])
}

/// Článok klubového webu — vytvára sa v portáli (ADMIN, MANAGER), na verejnom
/// webe sa zobrazuje len publikovaný (`publishedAt` v minulosti).
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  /// Krátky úvod (zoznam noviniek).
  excerpt     String
  /// Čistý text; odseky oddelené prázdnym riadkom. Žiadne HTML.
  body        String
  /// null = koncept (neverejný)
  publishedAt DateTime?
  authorId    String?
  /// Archívny oznam (napr. starý oznam z pôvodného webu) — na webe zreteľne označený.
  isArchive   Boolean   @default(false)
  /// Pôvodný zdroj (URL) pri prevzatom obsahu.
  sourceUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

/// Stav klubového obsahu: DRAFT = neverejný koncept, PUBLISHED = aktuálny obsah,
/// ARCHIVED = zreteľne označený archív (neprezentuje sa ako aktuálny).
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentCategory {
  CONTRACT
  SUBSIDY
  TAX_FORM
  ANNOUNCEMENT
  OTHER
}

enum ClubPersonGroup {
  MANAGEMENT
  COACH
  OTHER
}

/// Textová stránka klubového webu (história, o klube, kontakt…). Edituje sa v portáli.
model ClubPage {
  id          String        @id @default(cuid())
  /// Identifikátor stránky: o-klube | historia | kontakt | zverejnovanie | podpora | …
  slug        String        @unique
  title       String
  /// Čistý text. Odseky oddelené prázdnym riadkom; riadok začínajúci „## " je podnadpis. Žiadne HTML.
  body        String
  status      ContentStatus @default(DRAFT)
  /// Pôvodný zdroj obsahu (URL) a poznámka o jeho pôvode / platnosti.
  sourceUrl   String?
  sourceNote  String?
  /// Kedy obsah potvrdil klub (pred publikovaním aktuálnych údajov).
  confirmedAt DateTime?
  sortOrder   Int           @default(0)
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Funkcionár / tréner zobrazený na verejnom webe.
model ClubPerson {
  id          String          @id @default(cuid())
  name        String
  role        String
  group       ClubPersonGroup @default(MANAGEMENT)
  /// napr. kategória trénera („Žiaci U15")
  teamNote    String?
  phone       String?
  email       String?
  status      ContentStatus   @default(DRAFT)
  sourceUrl   String?
  sourceNote  String?
  confirmedAt DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Zverejnený dokument (zmluva, dotácia, tlačivo, oznam). Súbor sa ukladá bez zmeny
/// (pôvodný názov, obsah, kontrolný súčet), alebo sa ponechá len odkaz na zdroj.
model ClubDocument {
  id               String           @id @default(cuid())
  title            String
  description      String?
  category         DocumentCategory @default(OTHER)
  /// Dátum dokumentu podľa zdroja (nie dátum nahratia).
  documentDate     DateTime?
  originalFilename String?
  mimeType         String?
  size             Int?
  /// SHA-256 obsahu súboru (hex) — kontrola, že obsah nebol zmenený.
  sha256           String?
  data             Bytes?
  sourceUrl        String?
  sourceNote       String?
  status           ContentStatus    @default(DRAFT)
  confirmedAt      DateTime?
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, category])
}

// ---------------------------------------------------------------------------
// Nominácia hráčov z iných družstiev
// ---------------------------------------------------------------------------

enum NominationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Žiadosť o povolenie nominovať hráča z iného družstva (tréner zápasu hráča
/// netrénuje). Schvaľuje tréner družstva hráča (alebo vedenie); po schválení
/// vznikne MatchNomination. Jedna žiadosť na dvojicu zápas–hráč (opakovaná
/// žiadosť po zamietnutí sa vráti do stavu PENDING).
model NominationRequest {
  id            String                  @id @default(cuid())
  matchId       String
  memberId      String
  requestedById String
  status        NominationRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  note          String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  match       Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("NominationRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?  @relation("NominationRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([matchId, memberId])
  @@index([status])
}

/// Fáza časomiery zápasu (Match.timerPhase).
enum MatchTimerPhase {
  NOT_STARTED
  FIRST_HALF
  HALF_TIME
  SECOND_HALF
  FINISHED
}
